---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout currentPage="posts" title="posts">
  <div class="posts-index">
    {sortedPosts.map((post) => (
      <a href={`/posts/${post.id}`} class="post-link">
        <div class="post-entry">
          <h2>{post.data.title}</h2>
          <p class="post-entry-date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>
          {post.data.tagline && <p class="post-entry-tagline">{post.data.tagline}</p>}
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .posts-index {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-link {
    text-decoration: none;
    color: inherit;
  }

  .post-entry {
    padding: 1rem 0;
    border-bottom: 1px solid #ddd;
  }

  .post-entry:hover {
    opacity: 0.7;
  }

  .post-entry h2 {
    font-size: 1.5rem;
    font-weight: 400;
    padding-bottom: 0.3rem;
  }

  .post-entry-date {
    font-style: italic;
    font-weight: 300;
    font-size: 0.95rem;
    padding-bottom: 0.3rem;
  }

  .post-entry-tagline {
    font-weight: 300;
    font-size: 1rem;
    color: #555;
  }
</style>
